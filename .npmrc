# The @deepseek-ai/* packages this plugin peer-depends on are NOT published to
# npm — they ship inside the DeepSeek Harness distribution. Installing with
# --legacy-peer-deps skips their auto-install; at runtime they resolve from the
# DSH profile tree the plugin is installed into. For local typechecking, link
# the installed DSH packages into node_modules/@deepseek-ai (see README).
legacy-peer-deps=true
